# GEMINI_API_KEY: Required for Gemini AI API calls (Stage 4 optional reflection feature only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HEALI_DATA_KEY: 32-byte hex or passphrase used for server-side AES-256-GCM encryption
# of private journals and unsent letters at rest. Never expose to client (no VITE_ prefix).
HEALI_DATA_KEY=""

# HEALI_SESSION_SECRET: Secret used to sign/derive server session tokens.
HEALI_SESSION_SECRET=""

# FEATURE_PAID_SPIRITUAL: Keep 'false' until payment rails, host rules, and legal review are completed.
FEATURE_PAID_SPIRITUAL="false"

# ALLOWED_ORIGIN: Optional comma-separated origins for strict CORS in production.
ALLOWED_ORIGIN=""

# HEALI_ADMIN_PASSCODE: Passcode for internal moderator portal (/admin). Never prefix with VITE_.
HEALI_ADMIN_PASSCODE=""

